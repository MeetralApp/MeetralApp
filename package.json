{
  "name": "meetral",
  "private": true,
  "version": "4.8.6",
  "license": "MIT",
  "author": "iamnhaan",
  "repository": {
    "type": "git",
    "url": "https://github.com/MeetralApp/MeetralApp.git"
  },
  "description": "Real-time voice translation for online meetings",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:sparse": "node scripts/build-sparse.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:all": "vitest run && cd src-tauri && cargo test",
    "knip": "knip",
    "check:version": "node scripts/check-version-sync.mjs",
    "check": "node scripts/check-ci.mjs",
    "check:ci": "node scripts/check-ci.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json"
  },
  "knip": {
    "entry": [
      "src/**/*.{test,spec}.{ts,tsx}!",
      "src/test/**/*.ts!"
    ],
    "project": [
      "src/**/*.{ts,tsx}"
    ],
    "ignore": [
      "src/shared/ui/**"
    ],
    "ignoreDependencies": [
      "@tauri-apps/plugin-store",
      "tw-animate-css",
      "tailwindcss"
    ],
    "ignoreExportsUsedInFile": true
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.14.3",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-store": "^2.2.0",
    "@tiptap/core": "^3.29.0",
    "@tiptap/extension-placeholder": "^3.29.0",
    "@tiptap/pm": "^3.29.0",
    "@tiptap/react": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "@tiptap/suggestion": "^3.29.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.17",
    "lucide-react": "^1.21.0",
    "radix-ui": "^1.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^2.1.9",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "knip": "^6.26.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
