# Optional — the desktop app stores API keys in Settings (encrypted on disk).
# Copy to .env only if you use local tooling that reads these variables.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# Shared debug traces (STT endpoint, TTS append/flush, WS) — debug builds only
# (e.g. cargo tauri dev). Loaded from this file at startup. Logs go to the
# terminal and %APPDATA%/com.meetral.app/logs/app.log (Windows).
# DEBUG_MODE=1
